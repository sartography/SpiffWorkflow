<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_reset_mi" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="main" isExecutable="true">
    <bpmn:dataObject id="people" />
    <bpmn:dataObjectReference id="PeopleWritten" name="people" dataObjectRef="people" />
    <bpmn:dataObjectReference id="PeopleRead" name="people" dataObjectRef="people" />
    <bpmn:dataObjectReference id="PeopleReplaced" name="people" dataObjectRef="people" />
    <bpmn:dataObject id="answers" />
    <bpmn:dataObjectReference id="AnswersWritten" name="answers" dataObjectRef="answers" />
    <bpmn:dataObjectReference id="AnswersRead" name="answers" dataObjectRef="answers" />
    <bpmn:startEvent id="start">
      <bpmn:outgoing>to_set_people</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to_set_people" sourceRef="start" targetRef="set_people" />
    <bpmn:scriptTask id="set_people" name="Set People">
      <bpmn:incoming>to_set_people</bpmn:incoming>
      <bpmn:outgoing>to_each_person</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="write_people">
        <bpmn:targetRef>PeopleWritten</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>people = ["first", "second"]</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="to_each_person" sourceRef="set_people" targetRef="each_person" />
    <bpmn:subProcess id="each_person" name="Each Person">
      <bpmn:incoming>to_each_person</bpmn:incoming>
      <bpmn:outgoing>to_collect</bpmn:outgoing>
      <bpmn:property id="each_person_reads" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="read_people">
        <bpmn:sourceRef>PeopleRead</bpmn:sourceRef>
        <bpmn:targetRef>each_person_reads</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="write_answers">
        <bpmn:targetRef>AnswersWritten</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopDataInputRef>people</bpmn:loopDataInputRef>
        <bpmn:loopDataOutputRef>answers</bpmn:loopDataOutputRef>
        <bpmn:inputDataItem id="person" name="person" />
        <bpmn:outputDataItem id="answer" name="answer" />
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="person_start">
        <bpmn:outgoing>to_ask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="to_ask" sourceRef="person_start" targetRef="ask" />
      <bpmn:userTask id="ask" name="Ask">
        <bpmn:incoming>to_ask</bpmn:incoming>
        <bpmn:outgoing>to_person_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="to_person_end" sourceRef="ask" targetRef="person_end" />
      <bpmn:endEvent id="person_end">
        <bpmn:incoming>to_person_end</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="to_collect" sourceRef="each_person" targetRef="collect" />
    <bpmn:scriptTask id="collect" name="Collect">
      <bpmn:incoming>to_collect</bpmn:incoming>
      <bpmn:outgoing>to_review</bpmn:outgoing>
      <bpmn:property id="collect_reads" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="read_answers">
        <bpmn:sourceRef>AnswersRead</bpmn:sourceRef>
        <bpmn:targetRef>collect_reads</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:script>collected = list(answers)
del(answers)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="to_review" sourceRef="collect" targetRef="reuse_people" />
    <bpmn:scriptTask id="reuse_people" name="Reuse People">
      <bpmn:incoming>to_review</bpmn:incoming>
      <bpmn:outgoing>to_review_task</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="replace_people">
        <bpmn:targetRef>PeopleReplaced</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>people = ["someone else"]</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="to_review_task" sourceRef="reuse_people" targetRef="review" />
    <bpmn:userTask id="review" name="Review">
      <bpmn:incoming>to_review_task</bpmn:incoming>
      <bpmn:outgoing>to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="to_end" sourceRef="review" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
